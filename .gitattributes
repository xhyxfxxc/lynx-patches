#
# Line endings. The Gradle wrapper script is run by bash on Linux, so it has to keep LF;
# the Windows batch launchers need CRLF or cmd.exe misreads them.
/gradlew  text eol=lf
*.bat     text eol=crlf
# The phone helpers are sourced by bash (Git Bash on Windows): CRLF would break them.
/tools/phone/*.sh  text eol=lf
