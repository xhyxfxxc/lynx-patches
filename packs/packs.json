      "exclude": [
        "patches-bundle.json",
        ".github/**"
      ],
      "version": "0.25.0-lynx.1",
      "build": {
        "java": "21",
        "tasks": ":patches:generatePatchesList :patches:buildAndroid",
        "output": "patches/build/release/patches-*.mpp",
        "args": ""
      },
